{
  "manifest_version": 3,
  "name": "OTPBridge",
  "version": "0.1.0",
  "description": "Approve TOTP autofill on your Android phone. Your relay carries ciphertext only.",
  "permissions": ["contextMenus", "activeTab", "scripting", "storage"],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "OTPBridge" },
  "options_page": "options.html",
  "commands": {
    "fill-from-phone": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Fill focused OTP input from phone"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'"
  }
}
